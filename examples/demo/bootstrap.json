    {
      "slug": "demo-daily-logins",
      "name": "Daily Sign-ins per User",
      "scope": "Production",
      "group": "Security · Access",
      "definition": {
        "description": "Custom SQL report: sign-ins and failures per user per day.",
        "dataset": "SELECT date_trunc('day', event_time) AS day, username,\n       count(*) AS sign_ins,\n       sum(CASE WHEN result = 'FAILED' THEN 1 ELSE 0 END) AS failed\nFROM audit.access_log\nWHERE action = 'LOGIN'\nGROUP BY 1, 2",
        "time_field": "day",
        "fixed_filters": [],
        "params": [],
        "columns": [
          {
            "field": "day",
            "label": "Day",
            "width": 22,
            "format": "datetime"
          },
          {
            "field": "username",
            "label": "User",
            "width": 14,
            "format": "mono"
          },
          {
            "field": "sign_ins",
            "label": "Sign-ins",
            "width": 10,
            "format": "text"
          },
          {
            "field": "failed",
            "label": "Failed",
            "width": 10,
            "format": "text"
          }
        ],
        "row_rules": [],
        "sort": [
          {
            "field": "day",
            "dir": "desc"
          }
        ],
        "meta": {
          "title": "Daily Sign-ins per User – Production",
          "scope": "Production · Demo PostgreSQL",
          "notes": [
            [
              "Source",
              "Demo PostgreSQL · custom SQL"
            ]
          ]
        },
        "datasource": "Demo PostgreSQL"
      }
