{
  "format": 1,
  "datasources": [
    {
      "name": "Demo PostgreSQL",
      "type": "postgresql",
      "config": {
        "host": "db",
        "port": "5432",
        "database": "demo",
        "cred_file": "demo-cred",
        "sslmode": "disable",
        "timezone": "UTC"
      }
    }
  ],
  "scopes": [
    {
      "name": "Production",
      "kind": "application",
      "description": "Business applications (demo)"
    },
    {
      "name": "Infrastructure",
      "kind": "server",
      "description": "Servers and backups (demo)"
    }
  ],
  "templates": [
    {
      "slug": "demo-access-log",
      "name": "User Access Log",
      "scope": "Production",
      "group": "Security · Access",
      "definition": {
        "description": "Every sign-in, sign-out and privileged action on business applications, with source IP and result.",
        "dataset": "audit.access_log",
        "time_field": "event_time",
        "fixed_filters": [],
        "params": [
          {
            "field": "application",
            "label": "Application",
            "options": [
              "Admin Console",
              "Customer Portal",
              "Data Warehouse",
              "HR System",
              "Payments API"
            ]
          },
          {
            "field": "result",
            "label": "Result",
            "options": [
              "SUCCESS",
              "FAILED"
            ]
          }
        ],
        "columns": [
          {
            "field": "event_time",
            "label": "Time",
            "width": 22,
            "format": "datetime"
          },
          {
            "field": "username",
            "label": "User",
            "width": 14,
            "format": "mono"
          },
          {
            "field": "application",
            "label": "Application",
            "width": 18,
            "format": "text"
          },
          {
            "field": "action",
            "label": "Action",
            "width": 20,
            "format": "badge"
          },
          {
            "field": "source_ip",
            "label": "Source IP",
            "width": 18,
            "format": "mono"
          },
          {
            "field": "result",
            "label": "Result",
            "width": 20,
            "format": "badge"
          }
        ],
        "row_rules": [
          {
            "field": "result",
            "equals": "FAILED",
            "fill": "FCE4D6"
          }
        ],
        "sort": [
          {
            "field": "event_time",
            "dir": "desc"
          }
        ],
        "meta": {
          "title": "User Access Log – Production",
          "scope": "Production · Demo PostgreSQL",
          "notes": [
            [
              "Source",
              "Demo PostgreSQL · audit.access_log"
            ]
          ]
        },
        "datasource": "Demo PostgreSQL"
      }
    },
    {
      "slug": "demo-failed-logins",
      "name": "Failed Sign-ins",
      "scope": "Production",
      "group": "Security · Access",
      "definition": {
        "description": "Unsuccessful sign-in attempts. Repeated failures from one IP may indicate password guessing.",
        "dataset": "audit.access_log",
        "time_field": "event_time",
        "fixed_filters": [
          {
            "field": "action",
            "op": "eq",
            "value": "LOGIN"
          },
          {
            "field": "result",
            "op": "eq",
            "value": "FAILED"
          }
        ],
        "params": [
          {
            "field": "application",
            "label": "Application",
            "options": [
              "Admin Console",
              "Customer Portal",
              "Data Warehouse",
              "HR System",
              "Payments API"
            ]
          }
        ],
        "columns": [
          {
            "field": "event_time",
            "label": "Time",
            "width": 22,
            "format": "datetime"
          },
          {
            "field": "username",
            "label": "User",
            "width": 14,
            "format": "mono"
          },
          {
            "field": "application",
            "label": "Application",
            "width": 18,
            "format": "text"
          },
          {
            "field": "action",
            "label": "Action",
            "width": 20,
            "format": "badge"
          },
          {
            "field": "source_ip",
            "label": "Source IP",
            "width": 18,
            "format": "mono"
          },
          {
            "field": "result",
            "label": "Result",
            "width": 20,
            "format": "badge"
          }
        ],
        "row_rules": [],
        "sort": [
          {
            "field": "event_time",
            "dir": "desc"
          }
        ],
        "meta": {
          "title": "Failed Sign-ins – Production",
          "scope": "Production · Demo PostgreSQL",
          "notes": [
            [
              "Source",
              "Demo PostgreSQL · audit.access_log"
            ]
          ]
        },
        "datasource": "Demo PostgreSQL"
      }
    },
