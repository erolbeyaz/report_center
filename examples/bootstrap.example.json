      "slug": "prod-metrik-alarm-gecmisi",
      "name": "Alarm Geçmişi (saatlik)",
      "scope": "Prod Cluster",
      "group": "Metrikler · Alarmlar",
      "definition": {
        "description": "Saat içinde tetiklenmiş (firing) warning ve critical alarmlar: alarm adı, önem, namespace ve aynı anda kaç örnek.",
        "dataset": "count by (alertname, severity, namespace) (ALERTS{cluster=\"prod\",alertstate=\"firing\",severity=~\"warning|critical\"})",
        "time_field": "@timestamp",
        "fixed_filters": [],
        "params": [],
        "columns": [
          {
            "field": "@timestamp",
            "label": "Saat (yerel saat)",
            "width": 18,
            "format": "datetime"
          },
          {
            "field": "alertname",
            "label": "Alarm",
            "width": 32,
            "format": "text"
          },
          {
            "field": "severity",
            "label": "Önem",
            "width": 10,
            "format": "text"
          },
          {
            "field": "namespace",
            "label": "Namespace",
            "width": 18,
            "format": "text"
          },
          {
            "field": "value",
            "label": "Örnek sayısı",
            "width": 10,
            "format": "text"
          }
        ],
        "row_rules": [],
        "sort": [
          {
            "field": "@timestamp",
            "dir": "asc"
          }
        ],
        "meta": {
          "title": "Alarm Geçmişi (saatlik) – Prod Cluster",
          "scope": "Prod Cluster · Prometheus · cluster=\"prod\"",
          "notes": [
            [
              "Kaynak",
              "Prometheus · cluster=\"prod\""
            ],
            [
              "Zaman",
              "Her satır adım sonundaki değerdir; günlük raporlarda değer o tarihten önceki 24 saati, saatlik raporlarda önceki 1 saati kapsar."
            ]
          ]
